# Copy to .env for local development: `cp env.example .env`.
# `docker compose up` reads this file too, so PostgreSQL starts with the
# same credentials and port the API uses.
#
# The values below are development defaults. Outside development, set at
# least ENV, DB_HOST, DB_USER, DB_PASSWORD, DB_SSL_MODE, JWT_SECRET, and
# CORS_ORIGIN explicitly. With any ENV other
# than development, the API refuses to start with the JWT_SECRET or
# DB_PASSWORD below, and an unset DB_SSL_MODE means require.

# Server Configuration
PORT=8080
ENV=development

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=my_garden
# disable, allow, prefer, require, verify-ca, or verify-full
DB_SSL_MODE=disable

# JWT Configuration
# Outside development, use a random value of at least 32 characters,
# for example from `openssl rand -base64 48`.
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRY=24h

# Game Configuration
GAME_TICK_INTERVAL=5s
WEATHER_UPDATE_INTERVAL=5m
# Growth speed multiplier: 1 is real time (Lettuce takes 30 minutes); 60
# grows an hour's worth each minute, so Lettuce ripens in 30 seconds.
GAME_SPEED=60

# API Configuration
CORS_ORIGIN=http://localhost:5173
# Each client IP may send this many non-GET requests (sign-in included) per
# window; counts live in memory, per API instance.
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=1m
# Comma-separated IPs or CIDRs of reverse proxies whose X-Forwarded-For header
# identifies the client. Leave empty when clients connect directly.
TRUSTED_PROXIES=
