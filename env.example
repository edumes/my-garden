# Copy to .env for local development: `cp env.example .env`.
# `docker compose up` reads this file too, so PostgreSQL and Redis start
# with the same credentials and ports the API uses.
#
# The values below are development defaults. Outside development, set at
# least ENV, DB_HOST, DB_USER, DB_PASSWORD, DB_SSL_MODE, REDIS_HOST,
# REDIS_PASSWORD, JWT_SECRET, and CORS_ORIGIN explicitly.

# Server Configuration
PORT=8080
ENV=development

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=my_garden
DB_SSL_MODE=disable

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRY=24h

# Game Configuration
GAME_TICK_INTERVAL=5s
WEATHER_UPDATE_INTERVAL=5m
PLANT_GROWTH_INTERVAL=5s

# API Configuration
CORS_ORIGIN=http://localhost:5173
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=1m
